# --- Server ---
PORT=4000
NODE_ENV=development

# Comma-separated list of origins allowed by CORS.
CORS_ORIGINS=http://localhost:5173

# JWT secret for signing session tokens. Generate with: openssl rand -hex 64
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=30d

# --- Firebase Admin ---
# Either point to a service account JSON file...
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# ...or paste the service account JSON inline (single line, escaped).
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Realtime Database URL, e.g. https://family-calendar-xxxxx-default-rtdb.firebaseio.com
FIREBASE_DATABASE_URL=

# --- Initial admin seed (used by `npm run seed`) ---
SEED_USER_1_USERNAME=alex
SEED_USER_1_PASSWORD=change-me
SEED_USER_1_DISPLAY_NAME=Alex

SEED_USER_2_USERNAME=sam
SEED_USER_2_PASSWORD=change-me
SEED_USER_2_DISPLAY_NAME=Sam
