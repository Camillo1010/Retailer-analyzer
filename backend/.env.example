# --- Storage backend ---
# `memory` = no setup, data lost on restart (demo mode).
# `firebase` = persistent. Requires the Firebase vars below.
# If unset, defaults to `memory` when FIREBASE_DATABASE_URL is empty.
STORAGE=memory

# --- Server ---
PORT=4000
NODE_ENV=development

# Comma-separated list of origins allowed by CORS.
CORS_ORIGINS=http://localhost:5173

# JWT secret for signing session tokens. In demo mode, leave blank
# and the server will generate one at startup. For production,
# generate with: openssl rand -hex 64
JWT_SECRET=
JWT_EXPIRES_IN=30d

# --- Firebase (only needed when STORAGE=firebase) ---
# Either point to a service account JSON file...
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# ...or paste the service account JSON inline (single line, escaped).
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Realtime Database URL, e.g. https://family-calendar-xxxxx-default-rtdb.firebaseio.com
FIREBASE_DATABASE_URL=

# --- Initial admin seed (used by `npm run seed` in firebase mode) ---
SEED_USER_1_USERNAME=alex
SEED_USER_1_PASSWORD=change-me
SEED_USER_1_DISPLAY_NAME=Alex

SEED_USER_2_USERNAME=sam
SEED_USER_2_PASSWORD=change-me
SEED_USER_2_DISPLAY_NAME=Sam
